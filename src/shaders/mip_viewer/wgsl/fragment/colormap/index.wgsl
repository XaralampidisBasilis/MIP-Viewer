fn colormap(kind: i32, t: f32) -> vec3<f32>
{
    if (kind == 0) {
        return parula(t);
    } else if (kind == 1) {
        return turbo(t);
    } else if (kind == 2) {
        return hsv(t);
    } else if (kind == 3) {
        return hot(t);
    } else if (kind == 4) {
        return cool(t);
    } else if (kind == 5) {
        return spring(t);
    } else if (kind == 6) {
        return summer(t);
    } else if (kind == 7) {
        return autumn(t);
    } else if (kind == 8) {
        return winter(t);
    } else if (kind == 9) {
        return gray(t);
    } else if (kind == 10) {
        return bone(t);
    } else if (kind == 11) {
        return copper(t);
    } else if (kind == 12) {
        return pink(t);
    } else if (kind == 13) {
        return jet(t);
    } else if (kind == 14) {
        return pasteljet(t);
    } else if (kind == 15) {
        return viridis(t);
    } else if (kind == 16) {
        return plasma(t);
    } else if (kind == 17) {
        return inferno(t);
    } else if (kind == 18) {
        return magma(t);
    } else if (kind == 19) {
        return cividis(t);
    }

    return viridis(t);
}
