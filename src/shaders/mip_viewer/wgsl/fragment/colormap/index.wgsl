fn palette4(
    t: f32,
    a: vec3<f32>,
    b: vec3<f32>,
    c: vec3<f32>,
    d: vec3<f32>
) -> vec3<f32>
{
    return a + b * cos(6.283185 * (c * t + d));
}

fn palette8(
    t: f32,
    a: vec3<f32>,
    b0: vec3<f32>,
    c0: vec3<f32>,
    d0: vec3<f32>,
    b1: vec3<f32>,
    c1: vec3<f32>,
    d1: vec3<f32>
) -> vec3<f32>
{
    return a + b0 * cos(6.283185 * (c0 * t + d0)) + b1 * cos(6.283185 * (c1 * t + d1));
}

