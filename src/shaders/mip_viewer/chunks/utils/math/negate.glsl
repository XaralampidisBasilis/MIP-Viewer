#ifndef NEGATE
#define NEGATE

float negate(in float v) { return -v; }
vec2  negate(in vec2  v) { return -v; }
vec3  negate(in vec3  v) { return -v; }
vec4  negate(in vec4  v) { return -v; }

int   negate(in int   v) { return -v; }
ivec2 negate(in ivec2 v) { return -v; }
ivec3 negate(in ivec3 v) { return -v; }
ivec4 negate(in ivec4 v) { return -v; }

#endif // NEGATE